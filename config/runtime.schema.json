{
  "$defs": {
    "ArtifactsConfig": {
      "additionalProperties": false,
      "properties": {
        "max_object_bytes": {
          "default": 104857600,
          "exclusiveMinimum": 0,
          "title": "Max Object Bytes",
          "type": "integer"
        },
        "orphan_grace_seconds": {
          "default": 86400,
          "exclusiveMinimum": 0,
          "title": "Orphan Grace Seconds",
          "type": "integer"
        }
      },
      "title": "ArtifactsConfig",
      "type": "object"
    },
    "CodexConfig": {
      "additionalProperties": false,
      "properties": {
        "concurrency": {
          "default": 1,
          "exclusiveMinimum": 0,
          "title": "Concurrency",
          "type": "integer"
        },
        "total_timeout_seconds": {
          "default": 1800,
          "exclusiveMinimum": 0,
          "title": "Total Timeout Seconds",
          "type": "integer"
        }
      },
      "title": "CodexConfig",
      "type": "object"
    },
    "CreatorConfig": {
      "additionalProperties": false,
      "properties": {
        "bind_host": {
          "const": "127.0.0.1",
          "default": "127.0.0.1",
          "title": "Bind Host",
          "type": "string"
        },
        "bootstrap_ttl_seconds": {
          "default": 120,
          "exclusiveMinimum": 0,
          "title": "Bootstrap Ttl Seconds",
          "type": "integer"
        },
        "port": {
          "maximum": 65535,
          "minimum": 1024,
          "title": "Port",
          "type": "integer"
        },
        "request_body_max_bytes": {
          "default": 262144,
          "exclusiveMinimum": 0,
          "title": "Request Body Max Bytes",
          "type": "integer"
        },
        "session_ttl_seconds": {
          "default": 28800,
          "exclusiveMinimum": 0,
          "title": "Session Ttl Seconds",
          "type": "integer"
        }
      },
      "required": [
        "port"
      ],
      "title": "CreatorConfig",
      "type": "object"
    },
    "DatabaseConfig": {
      "additionalProperties": false,
      "properties": {
        "diagnostic_statement_timeout_seconds": {
          "default": 30,
          "exclusiveMinimum": 0,
          "title": "Diagnostic Statement Timeout Seconds",
          "type": "integer"
        },
        "pool_acquire_timeout_seconds": {
          "default": 5,
          "exclusiveMinimum": 0,
          "title": "Pool Acquire Timeout Seconds",
          "type": "integer"
        },
        "pool_max": {
          "default": 12,
          "exclusiveMinimum": 0,
          "title": "Pool Max",
          "type": "integer"
        },
        "pool_min": {
          "default": 2,
          "exclusiveMinimum": 0,
          "title": "Pool Min",
          "type": "integer"
        },
        "statement_timeout_seconds": {
          "default": 5,
          "exclusiveMinimum": 0,
          "title": "Statement Timeout Seconds",
          "type": "integer"
        }
      },
      "title": "DatabaseConfig",
      "type": "object"
    },
    "EnvironmentConfig": {
      "additionalProperties": false,
      "properties": {
        "data_root": {
          "format": "windows-absolute-path",
          "title": "Data Root",
          "type": "string"
        },
        "environment_id": {
          "format": "uuid",
          "title": "Environment Id",
          "type": "string",
          "x-uuid-version": 7
        }
      },
      "required": [
        "environment_id",
        "data_root"
      ],
      "title": "EnvironmentConfig",
      "type": "object"
    },
    "LifecycleConfig": {
      "additionalProperties": false,
      "properties": {
        "graceful_shutdown_seconds": {
          "default": 30,
          "exclusiveMinimum": 0,
          "title": "Graceful Shutdown Seconds",
          "type": "integer"
        }
      },
      "title": "LifecycleConfig",
      "type": "object"
    },
    "MaintenanceConfig": {
      "additionalProperties": false,
      "properties": {
        "consideration_after_seconds": {
          "default": 57600,
          "exclusiveMinimum": 0,
          "title": "Consideration After Seconds",
          "type": "integer"
        },
        "deadline_after_seconds": {
          "default": 86400,
          "exclusiveMinimum": 0,
          "title": "Deadline After Seconds",
          "type": "integer"
        }
      },
      "title": "MaintenanceConfig",
      "type": "object"
    },
    "ModelConfig": {
      "additionalProperties": false,
      "properties": {
        "attempt_timeout_seconds": {
          "default": 180,
          "exclusiveMinimum": 0,
          "title": "Attempt Timeout Seconds",
          "type": "integer"
        },
        "concurrency": {
          "default": 2,
          "exclusiveMinimum": 0,
          "title": "Concurrency",
          "type": "integer"
        },
        "episode_max_attempts": {
          "default": 2,
          "exclusiveMinimum": 0,
          "title": "Episode Max Attempts",
          "type": "integer"
        }
      },
      "title": "ModelConfig",
      "type": "object"
    },
    "RuntimeLeaseConfig": {
      "additionalProperties": false,
      "properties": {
        "heartbeat_seconds": {
          "default": 10,
          "exclusiveMinimum": 0,
          "title": "Heartbeat Seconds",
          "type": "integer"
        },
        "lease_seconds": {
          "default": 30,
          "exclusiveMinimum": 0,
          "title": "Lease Seconds",
          "type": "integer"
        }
      },
      "title": "RuntimeLeaseConfig",
      "type": "object"
    },
    "SchedulerConfig": {
      "additionalProperties": false,
      "properties": {
        "idle_poll_initial_seconds": {
          "default": 1,
          "exclusiveMinimum": 0,
          "title": "Idle Poll Initial Seconds",
          "type": "integer"
        },
        "idle_poll_max_seconds": {
          "default": 10,
          "exclusiveMinimum": 0,
          "title": "Idle Poll Max Seconds",
          "type": "integer"
        }
      },
      "title": "SchedulerConfig",
      "type": "object"
    },
    "WebConfig": {
      "additionalProperties": false,
      "properties": {
        "concurrency": {
          "default": 1,
          "exclusiveMinimum": 0,
          "title": "Concurrency",
          "type": "integer"
        },
        "step_timeout_seconds": {
          "default": 30,
          "exclusiveMinimum": 0,
          "title": "Step Timeout Seconds",
          "type": "integer"
        },
        "total_timeout_seconds": {
          "default": 90,
          "exclusiveMinimum": 0,
          "title": "Total Timeout Seconds",
          "type": "integer"
        }
      },
      "title": "WebConfig",
      "type": "object"
    },
    "WorkConfig": {
      "additionalProperties": false,
      "properties": {
        "heartbeat_seconds": {
          "default": 20,
          "exclusiveMinimum": 0,
          "title": "Heartbeat Seconds",
          "type": "integer"
        },
        "lease_seconds": {
          "default": 60,
          "exclusiveMinimum": 0,
          "title": "Lease Seconds",
          "type": "integer"
        },
        "max_deadline_seconds": {
          "default": 3600,
          "exclusiveMinimum": 0,
          "title": "Max Deadline Seconds",
          "type": "integer"
        }
      },
      "title": "WorkConfig",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "The only supported effective runtime configuration shape.",
  "properties": {
    "artifacts": {
      "$ref": "#/$defs/ArtifactsConfig",
      "default": {
        "max_object_bytes": 104857600,
        "orphan_grace_seconds": 86400
      }
    },
    "codex": {
      "$ref": "#/$defs/CodexConfig",
      "default": {
        "concurrency": 1,
        "total_timeout_seconds": 1800
      }
    },
    "creator": {
      "$ref": "#/$defs/CreatorConfig"
    },
    "database": {
      "$ref": "#/$defs/DatabaseConfig",
      "default": {
        "diagnostic_statement_timeout_seconds": 30,
        "pool_acquire_timeout_seconds": 5,
        "pool_max": 12,
        "pool_min": 2,
        "statement_timeout_seconds": 5
      }
    },
    "environment": {
      "$ref": "#/$defs/EnvironmentConfig"
    },
    "lifecycle": {
      "$ref": "#/$defs/LifecycleConfig",
      "default": {
        "graceful_shutdown_seconds": 30
      }
    },
    "maintenance": {
      "$ref": "#/$defs/MaintenanceConfig",
      "default": {
        "consideration_after_seconds": 57600,
        "deadline_after_seconds": 86400
      }
    },
    "model": {
      "$ref": "#/$defs/ModelConfig",
      "default": {
        "attempt_timeout_seconds": 180,
        "concurrency": 2,
        "episode_max_attempts": 2
      }
    },
    "runtime": {
      "$ref": "#/$defs/RuntimeLeaseConfig",
      "default": {
        "heartbeat_seconds": 10,
        "lease_seconds": 30
      }
    },
    "scheduler": {
      "$ref": "#/$defs/SchedulerConfig",
      "default": {
        "idle_poll_initial_seconds": 1,
        "idle_poll_max_seconds": 10
      }
    },
    "schema_version": {
      "const": "armi.runtime-config.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "secret_locators": {
      "additionalProperties": {
        "pattern": "^[a-z][a-z0-9-]{1,31}:.{1,2048}$",
        "type": "string"
      },
      "title": "Secret Locators",
      "type": "object"
    },
    "web": {
      "$ref": "#/$defs/WebConfig",
      "default": {
        "concurrency": 1,
        "step_timeout_seconds": 30,
        "total_timeout_seconds": 90
      }
    },
    "work": {
      "$ref": "#/$defs/WorkConfig",
      "default": {
        "heartbeat_seconds": 20,
        "lease_seconds": 60,
        "max_deadline_seconds": 3600
      }
    }
  },
  "required": [
    "schema_version",
    "environment",
    "creator"
  ],
  "title": "RuntimeConfig",
  "type": "object"
}
