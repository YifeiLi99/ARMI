  "transaction_control_exemptions": [
    {
      "id": "schema-migration-transaction",
      "module": "armi_runtime.adapters.persistence.schema_gateway",
      "reason": "Packaged migrations require one transaction per immutable migration."
    },
    {
      "id": "runtime-pool-reset",
      "module": "armi_runtime.adapters.persistence.role_policy",
      "reason": "The role-bound pool must rollback and reset contaminated sessions."
    },
    {
      "id": "admin-pool-reset",
      "module": "armi_admin.persistence.role_session",
      "reason": "The role-bound pool must rollback and reset contaminated sessions."
    },
    {
      "id": "admin-observation-transaction",
      "module": "armi_admin.persistence.observation_gateway",
      "reason": "Bounded Admin observations use explicit read-only transactions; the sole environment registration insert is restricted by the Admin database role."
    },
    {
      "id": "admin-environment-reset-transaction",
      "module": "armi_admin.persistence.environment_gateway",
      "reason": "The disposable-environment reset gateway atomically recreates only the packaged armi schema before the fixed migration entry runs."
    },
    {
      "id": "runtime-authority-control-transaction",
      "module": "armi_runtime.adapters.persistence.runtime_authority",
      "reason": "Authority acquire, heartbeat and release require explicit atomic control transactions."
    },
    {
      "id": "runtime-recovery-control-transaction",
      "module": "armi_runtime.adapters.persistence.recovery",
      "reason": "Recovery repairs and their normal-audit facts require one current-fence transaction; artifact byte verification remains outside it."
    },
    {
      "id": "scene-timeline-read-transaction",
      "module": "armi_runtime.adapters.persistence.scene_timeline",
      "reason": "The authority query uses a dedicated read-only transaction and cannot write or acquire a fence."
    }
  ],
