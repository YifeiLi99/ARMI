{
  "schema_version": "armi.architecture-policy.v1",
  "persistence_markers": ["persistence", "repositories", "repository"],
  "database_driver_roots": ["psycopg", "psycopg_pool"],
  "database_driver_boundaries": [
    {
      "id": "transaction-error-mapping",
      "module": "armi_runtime.adapters.transaction_errors",
      "reason": "Maps PostgreSQL SQLSTATE and pool failures without owning writes."
    },
    {
      "id": "creator-identity-read",
      "module": "armi_runtime.adapters.creator_identity",
      "reason": "Reads the existing unique Creator party without owning or mutating database facts."
    }
  ],
  "write_surfaces": [
    {
      "id": "schema-governance",
      "module": "armi_runtime.adapters.persistence.schema_gateway",
      "owner": "schema-governance",
      "allowed_callers": ["armi_runtime.composition.database"]
    },
    {
      "id": "database-role-policy-runtime",
      "module": "armi_runtime.adapters.persistence.role_policy",
      "owner": "database-role-policy",
      "allowed_callers": [
        "armi_runtime.adapters.persistence.runtime_authority",
        "armi_runtime.adapters.persistence.recovery",
        "armi_runtime.adapters.persistence.scene_timeline",
        "armi_runtime.adapters.persistence.schema_gateway",
        "armi_runtime.adapters.persistence.unit_of_work"
      ]
    },
    {
      "id": "database-role-policy-admin",
      "module": "armi_admin.persistence.role_session",
      "owner": "database-role-policy",
      "allowed_callers": []
    },
    {
      "id": "artifact-catalog",
      "module": "armi_runtime.adapters.persistence.artifact_catalog",
      "owner": "artifact-catalog",
      "allowed_callers": ["armi_runtime.composition.artifacts"]
    },
    {
      "id": "normal-audit",
      "module": "armi_runtime.adapters.persistence.audit_events",
      "owner": "normal-audit",
      "allowed_callers": [
        "armi_runtime.adapters.persistence.runtime_authority",
        "armi_runtime.adapters.persistence.unit_of_work",
        "armi_runtime.composition.audit"
      ]
    },
    {
      "id": "durable-work",
      "module": "armi_runtime.adapters.persistence.durable_work",
      "owner": "durable-work",
      "allowed_callers": [
        "armi_runtime.adapters.persistence.unit_of_work"
      ]
    },
    {
      "id": "internal-outbox",
      "module": "armi_runtime.adapters.persistence.outbox",
      "owner": "durable-work",
      "allowed_callers": []
    },
    {
      "id": "unique-birth",
      "module": "armi_runtime.adapters.persistence.birth",
      "owner": "subject-continuity",
      "allowed_callers": [
        "armi_runtime.composition.birth",
        "armi_runtime.composition.database"
      ]
    },
    {
      "id": "runtime-authority",
      "module": "armi_runtime.adapters.persistence.runtime_authority",
      "owner": "runtime-authority",
      "allowed_callers": [
        "armi_runtime.composition.database"
      ]
    },
    {
      "id": "runtime-recovery",
      "module": "armi_runtime.adapters.persistence.recovery",
      "owner": "runtime-recovery",
      "allowed_callers": [
        "armi_runtime.composition.database"
      ]
    },
    {
      "id": "runtime-recovery-responsibility-repair",
      "module": "armi_runtime.adapters.persistence.recovery_responsibilities",
      "owner": "runtime-recovery",
      "allowed_callers": [
        "armi_runtime.adapters.persistence.recovery"
      ]
    },
    {
      "id": "scene-timeline-query",
      "module": "armi_runtime.adapters.persistence.scene_timeline",
      "owner": "creator-projection",
      "allowed_callers": [
        "armi_runtime.composition.database"
      ]
    }
  ],
  "write_surfaces_not_applicable_reason": "",
  "named_coordinators": [
    {
      "id": "runtime-unit-of-work",
      "module": "armi_runtime.adapters.persistence.unit_of_work",
      "owner": "transaction-coordination",
      "allowed_write_surfaces": ["normal-audit", "durable-work"]
    },
    {
      "id": "artifact-registration",
      "module": "armi_runtime.composition.artifacts",
      "owner": "artifact-catalog",
      "allowed_write_surfaces": ["artifact-catalog", "normal-audit"]
    },
    {
      "id": "durable-work-custody",
      "module": "armi_runtime.adapters.persistence.durable_work",
      "owner": "durable-work",
      "allowed_write_surfaces": ["durable-work", "normal-audit"]
    },
    {
      "id": "internal-outbox-dispatch",
      "module": "armi_runtime.adapters.persistence.outbox",
      "owner": "durable-work",
      "allowed_write_surfaces": ["internal-outbox", "normal-audit"]
    },
    {
      "id": "unique-birth-transaction",
      "module": "armi_runtime.composition.birth",
      "owner": "subject-continuity",
      "allowed_write_surfaces": [
        "unique-birth",
        "artifact-catalog",
        "normal-audit"
      ]
    },
    {
      "id": "runtime-authority-control",
      "module": "armi_runtime.adapters.persistence.runtime_authority",
      "owner": "runtime-authority",
      "allowed_write_surfaces": [
        "runtime-authority",
        "normal-audit",
        "database-role-policy-runtime"
      ]
    },
    {
      "id": "runtime-startup-recovery",
      "module": "armi_runtime.adapters.persistence.recovery",
      "owner": "runtime-recovery",
      "allowed_write_surfaces": [
        "runtime-recovery",
        "runtime-recovery-responsibility-repair",
        "durable-work",
        "internal-outbox",
        "artifact-catalog",
        "normal-audit",
        "database-role-policy-runtime"
      ]
    }
  ],
  "named_coordinators_not_applicable_reason": "",
  "transaction_control_exemptions": [
    {
      "id": "schema-migration-transaction",
      "module": "armi_runtime.adapters.persistence.schema_gateway",
      "reason": "Packaged migrations require one transaction per immutable migration."
    },
    {
      "id": "runtime-pool-reset",
      "module": "armi_runtime.adapters.persistence.role_policy",
      "reason": "The role-bound pool must rollback and reset contaminated sessions."
    },
    {
      "id": "admin-pool-reset",
      "module": "armi_admin.persistence.role_session",
      "reason": "The role-bound pool must rollback and reset contaminated sessions."
    },
    {
      "id": "runtime-authority-control-transaction",
      "module": "armi_runtime.adapters.persistence.runtime_authority",
      "reason": "Authority acquire, heartbeat and release require explicit atomic control transactions."
    },
    {
      "id": "runtime-recovery-control-transaction",
      "module": "armi_runtime.adapters.persistence.recovery",
      "reason": "Recovery repairs and their normal-audit facts require one current-fence transaction; artifact byte verification remains outside it."
    },
    {
      "id": "scene-timeline-read-transaction",
      "module": "armi_runtime.adapters.persistence.scene_timeline",
      "reason": "The authority query uses a dedicated read-only transaction and cannot write or acquire a fence."
    }
  ],
  "transaction_control_exemptions_not_applicable_reason": "",
  "coordinator_forbidden_io_roots": [
    "httpx",
    "mcp",
    "openai",
    "playwright"
  ],
  "forbidden_entry_points": [],
  "forbidden_entry_points_not_applicable_reason": "The greenfield S004 baseline has no replaced production entry point.",
  "creator_web": {
    "source_root": "apps/armi-creator-web/src",
    "generated_file": "apps/armi-creator-web/src/api/generated/creator.ts",
    "static_resource_root": "apps/armi-runtime/src/armi_runtime/interfaces/creator_web_resources",
    "features": [
      "session",
      "scene"
    ],
    "features_not_applicable_reason": "",
    "event_stream": {
      "transport": "authenticated-fetch-sse",
      "client": "apps/armi-creator-web/src/api/eventStream.ts",
      "broker": "armi_runtime.interfaces.creator_events.CreatorEventBroker",
      "fact_source": false,
      "runtime_discovery": false,
      "persistent_event_cache": false
    },
    "runtime_discovery": false
  },
  "runtime_composition": {
    "entry_point": "armi",
    "manifest": "apps/armi-runtime/src/armi_runtime/composition/runtime_resources/runtime-composition.manifest.json",
    "active_bindings": {
      "M0-SEAM-CREATOR-PROJECTION": "armi.scene-timeline-query.v1",
      "M0-SEAM-CREATOR-UI": "armi.creator-static.v1"
    },
    "runtime_discovery": false
  }
}
