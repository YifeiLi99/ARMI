  "production_cognition_tools": [],
  "provider": "volcengine_ark",
  "purpose": "public_web_research",
  "response_api_base": "https://ark.cn-beijing.volces.com/api/v3",
  "result_contract": "armi.web-search-result.v1",
  "schema_version": "armi.web-search-custody.v1",
  "store": false,
  "tool_actions": [
    "search",
    "open_page",
    "find_in_page"
  ],
  "tool_declaration": {
    "type": "web_search"
  }
}
