{
  "$defs": {
    "AdminEnvironmentKind": {
      "enum": [
        "development",
        "system_test",
        "acceptance"
      ],
      "title": "AdminEnvironmentKind",
      "type": "string"
    },
    "AdminExpectedIdentity": {
      "additionalProperties": false,
      "properties": {
        "package_digest": {
          "title": "Package Digest",
          "type": "string"
        }
      },
      "required": [
        "package_digest"
      ],
      "title": "AdminExpectedIdentity",
      "type": "object"
    },
    "AdminLogSettings": {
      "additionalProperties": false,
      "properties": {
        "level": {
          "default": "warning",
          "enum": [
            "warning",
            "error"
          ],
          "title": "Level",
          "type": "string"
        },
        "sink": {
          "const": "stderr",
          "default": "stderr",
          "title": "Sink",
          "type": "string"
        }
      },
      "title": "AdminLogSettings",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "One explicit non-production environment binding.",
  "properties": {
    "database_locator": {
      "title": "Database Locator",
      "type": "string"
    },
    "environment_id": {
      "title": "Environment Id",
      "type": "string"
    },
    "environment_incarnation": {
      "title": "Environment Incarnation",
      "type": "integer"
    },
    "environment_kind": {
      "$ref": "#/$defs/AdminEnvironmentKind"
    },
    "environment_root": {
      "format": "path",
      "title": "Environment Root",
      "type": "string"
    },
    "expected": {
      "$ref": "#/$defs/AdminExpectedIdentity"
    },
    "experiment_root": {
      "format": "path",
      "title": "Experiment Root",
      "type": "string"
    },
    "logging": {
      "$ref": "#/$defs/AdminLogSettings",
      "default": {
        "level": "warning",
        "sink": "stderr"
      }
    },
    "migrator_database_locator": {
      "title": "Migrator Database Locator",
      "type": "string"
    },
    "postgresql_tool_root": {
      "format": "path",
      "title": "Postgresql Tool Root",
      "type": "string"
    },
    "postgresql_version": {
      "const": "18.4",
      "default": "18.4",
      "title": "Postgresql Version",
      "type": "string"
    },
    "preview_key_locator": {
      "title": "Preview Key Locator",
      "type": "string"
    },
    "resettable": {
      "title": "Resettable",
      "type": "boolean"
    },
    "schema_version": {
      "const": "armi.admin-config.v3",
      "title": "Schema Version",
      "type": "string"
    },
    "template_manifest": {
      "format": "path",
      "title": "Template Manifest",
      "type": "string"
    },
    "test_controls_enabled": {
      "title": "Test Controls Enabled",
      "type": "boolean"
    }
  },
  "required": [
    "schema_version",
    "environment_kind",
    "environment_id",
    "environment_incarnation",
    "resettable",
    "test_controls_enabled",
    "environment_root",
    "experiment_root",
    "template_manifest",
    "postgresql_tool_root",
    "database_locator",
    "migrator_database_locator",
    "preview_key_locator",
    "expected"
  ],
  "title": "AdminConfig",
  "type": "object"
}
