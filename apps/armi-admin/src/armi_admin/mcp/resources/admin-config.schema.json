{
  "$defs": {
    "AdminEnvironmentKind": {
      "enum": [
        "active",
        "development",
        "system_test",
        "acceptance"
      ],
      "title": "AdminEnvironmentKind",
      "type": "string"
    },
    "AdminExpectedIdentity": {
      "additionalProperties": false,
      "properties": {
        "package_set_digest": {
          "title": "Package Set Digest",
          "type": "string"
        }
      },
      "required": [
        "package_set_digest"
      ],
      "title": "AdminExpectedIdentity",
      "type": "object"
    },
    "AdminLogSettings": {
      "additionalProperties": false,
      "properties": {
        "level": {
          "default": "warning",
          "enum": [
            "warning",
            "error"
          ],
          "title": "Level",
          "type": "string"
        },
        "sink": {
          "const": "stderr",
          "default": "stderr",
          "title": "Sink",
          "type": "string"
        }
      },
      "title": "AdminLogSettings",
      "type": "object"
    },
    "PostgreSQLControlBinding": {
      "additionalProperties": false,
      "properties": {
        "data_directory": {
          "format": "windows-absolute-path",
          "title": "Data Directory",
          "type": "string"
        },
        "installation_root": {
          "format": "windows-absolute-path",
          "title": "Installation Root",
          "type": "string"
        },
        "ownership": {
          "enum": [
            "exclusive",
            "shared"
          ],
          "title": "Ownership",
          "type": "string"
        },
        "port": {
          "maximum": 65535,
          "minimum": 1024,
          "title": "Port",
          "type": "integer"
        }
      },
      "required": [
        "ownership",
        "installation_root",
        "data_directory",
        "port"
      ],
      "title": "PostgreSQLControlBinding",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "One explicit environment binding, including authorized active operation.",
  "properties": {
    "authorization_public_key": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Authorization Public Key"
    },
    "authorization_signing_key_locator": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "authorized_operations": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Authorized Operations",
      "type": "array"
    },
    "creator_web_resources": {
      "anyOf": [
        {
          "format": "path",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Creator Web Resources"
    },
    "database_locator": {
      "title": "Database Locator",
      "type": "string"
    },
    "environment_id": {
      "title": "Environment Id",
      "type": "string"
    },
    "environment_incarnation": {
      "title": "Environment Incarnation",
      "type": "integer"
    },
    "environment_kind": {
      "$ref": "#/$defs/AdminEnvironmentKind"
    },
    "environment_root": {
      "format": "path",
      "title": "Environment Root",
      "type": "string"
    },
    "expected": {
      "$ref": "#/$defs/AdminExpectedIdentity"
    },
    "experiment_root": {
      "anyOf": [
        {
          "format": "path",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Experiment Root"
    },
    "logging": {
      "$ref": "#/$defs/AdminLogSettings",
      "default": {
        "level": "warning",
        "sink": "stderr"
      }
    },
    "migrator_database_locator": {
      "title": "Migrator Database Locator",
      "type": "string"
    },
    "operator_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9._:-]+$",
      "title": "Operator Id",
      "type": "string"
    },
    "postgresql_client_root": {
      "anyOf": [
        {
          "format": "path",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Postgresql Client Root"
    },
    "postgresql_control": {
      "anyOf": [
        {
          "$ref": "#/$defs/PostgreSQLControlBinding"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "postgresql_version": {
      "const": "18.4",
      "default": "18.4",
      "title": "Postgresql Version",
      "type": "string"
    },
    "preview_key_locator": {
      "title": "Preview Key Locator",
      "type": "string"
    },
    "resettable": {
      "title": "Resettable",
      "type": "boolean"
    },
    "runtime_defaults_path": {
      "anyOf": [
        {
          "format": "path",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Runtime Defaults Path"
    },
    "schema_version": {
      "const": "armi.admin-config.v8",
      "title": "Schema Version",
      "type": "string"
    },
    "template_manifest": {
      "anyOf": [
        {
          "format": "path",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Template Manifest"
    },
    "test_controls_enabled": {
      "title": "Test Controls Enabled",
      "type": "boolean"
    }
  },
  "required": [
    "schema_version",
    "operator_id",
    "authorized_operations",
    "environment_kind",
    "environment_id",
    "environment_incarnation",
    "resettable",
    "test_controls_enabled",
    "environment_root",
    "database_locator",
    "migrator_database_locator",
    "preview_key_locator",
    "expected"
  ],
  "title": "AdminConfig",
  "type": "object"
}
